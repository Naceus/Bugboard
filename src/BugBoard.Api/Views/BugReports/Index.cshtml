@model BugReportIndexViewModel

@{
    ViewData["Title"] = "Bug Reports";
}
@section Styles{
    <link rel="stylesheet" href="~/css/bug-reports.css" asp-append-version="true" />
}

<div class="bug-report-page">
    <div class="bug-report-actions">
        <a class="btn btn-success bug-report-create-button" asp-action="Create">
            @Localizer["Create New"]
        </a>
    </div>

    <form id="bugReportFilterForm"
          asp-action="Index"
          method="get"
          class="filter-card bug-report-filters">

        <div class="bug-report-filter-grid">
            <div>
                <label class="form-label" for="titleSearch">@Localizer["Search"]</label>
                <input name="title"
                       id="titleSearch"
                       class="form-control"
                       placeholder="@Localizer["Search title"]"
                       value="@Model.Search" />
            </div>

            <div>
                <label class="form-label" for="statusFilter">@Localizer["Status"]</label>
                <select name="status" id="statusFilter" class="form-select">
                    <option value="">@Localizer["All statuses"]</option>

                    @foreach (var status in Enum.GetValues<BugStatus>())
                    {
                        <option value="@status" selected="@(Model.SelectedStatus == status)">
                            @Localizer[status.ToString()]
                        </option>
                    }
                </select>
            </div>

            <div>
                <label class="form-label" for="priorityFilter">@Localizer["Priority"]</label>
                <select name="priority" id="priorityFilter" class="form-select">
                    <option value="">@Localizer["All priorities"]</option>

                    @foreach (var priority in Enum.GetValues<BugPriority>())
                    {
                        <option value="@priority" selected="@(Model.SelectedPriority == priority)">
                            @Localizer[priority.ToString()]
                        </option>
                    }
                </select>
            </div>

            <div class="bug-report-filter-actions">
                <a asp-action="Index" class="btn btn-secondary">
                    @Localizer["Reset"]
                </a>
            </div>

        </div>
    </form>

    <div id="bugReportTableContainer">
        <partial name="_BugReportTable" model="Model" />
        <partial name="_Pagination" model="Model" />
    </div>
</div>

@section Scripts {
    <script src="~/js/bugboard-search.js" asp-append-version="true"></script>
}
