
@model BugReportDetailsViewModel

@{
    ViewData["Title"] = "Details";
}

@section Styles {
    <link rel="stylesheet" href="~/css/bug-reports.css" asp-append-version="true" />
}

<h1>Details</h1>
<div>
    <hr />
    <div class="mb-3">
        <div class="d-flex gap-2 align-items-center w-100">
            <a class="btn btn-dark" asp-action="Index">Back</a>
            @if (User.IsInRole(ApplicationRoles.Admin) || User.IsInRole(ApplicationRoles.Developer))
            {
                <a class="btn btn-success" asp-action="Edit" asp-route-id="@Model.BugReport.Id">Edit</a>
                
            }
            @if (User.IsInRole(ApplicationRoles.Admin))
            {
                <form asp-action="Delete" asp-route-id="@Model.BugReport.Id" method="post"
                    onsubmit="return confirm('Are you sure want to delete this bug report?');" class="ms-auto">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>                
            }
        </div>
    </div>
    <dl class="row">

        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.BugReport.Title)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.BugReport.Title)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.BugReport.Description)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.BugReport.Description)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.BugReport.CreatedByUser)
        </dt>
        <dd class=" col-sm-10">
            @(Model.BugReport.CreatedByUser != null ? $"{Model.BugReport.CreatedByUser.FirstName} {Model.BugReport.CreatedByUser.LastName}" : "Unknown")
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.BugReport.Status)
        </dt>
        <dd class = "col-sm-10">
        <partial name="_StatusBadge" model="Model.BugReport.Status"/>
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.BugReport.Priority)
        </dt>
        <dd class = "col-sm-10">
         <partial name="_PriorityBadge" model="Model.BugReport.Priority"/>
            
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.BugReport.AssignedTo)
        </dt>
        <dd class = "col-sm-10">
        @(string.IsNullOrWhiteSpace(Model.BugReport.AssignedTo) ? "Unassigned" : Model.BugReport.AssignedTo)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.BugReport.CreateAt)
        </dt>
        <dd class = "col-sm-10">
            @Model.BugReport.CreateAt.ToDisplayDateTime()
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.BugReport.UpdatedAt)
        </dt>
        <dd class = "col-sm-10">
            @Model.BugReport.UpdatedAt.ToDisplayDateTime()
        </dd>
    </dl>
</div>
<hr />
<section class="bug-report-attachments">
    <div class="bug-report-attachments-header">
        <h2>Attachments</h2>
        <span class="bug-report-attachments-count">@Model.Attachments.Count</span>
    </div>

    @if (!Model.Attachments.Any())
    {
        <div class="bug-report-attachments-empty">
            No attachments uploaded.
        </div>
    }
    else
    {
        <div class="bug-report-attachments-list">
            @foreach (var attachment in Model.Attachments)
            {
                <article class="bug-report-attachment-item">
                    <div class="bug-report-attachment-main">
                        <a asp-action="ViewAttachment"
                           asp-route-id="@attachment.Id"
                           target="_blank"
                           rel="noopener"
                           class="bug-report-attachment-link">
                            @attachment.OriginalFileName
                        </a>
                        <span>@attachment.ContentType</span>
                    </div>
                    <div class="bug-report-attachment-meta">
                        <span>@FormatFileSize(attachment.FileSize)</span>
                        <span>@attachment.UploadedAt.ToDisplayDateTime()</span>
                    </div>
                </article>
            }
        </div>
    }
</section>

<hr />
<section class="bug-report-activity">
    <div class="bug-report-activity-header">
        <h2>Activity</h2>
    </div>

    <form class="bug-report-comment-form" asp-action="CreateComment" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="BugReportId" value="@Model.NewComment.BugReportId" />

        <div class="bug-report-comment-input">
            <label class="form-label" for="Comment">Comment</label>
            <textarea class="form-control"
                      id="Comment"
                      name="Comment"
                      rows="4"
                      maxlength="2000"
                      placeholder="Write a comment..."></textarea>
        </div>

        <div class="bug-report-comment-actions">
            @if (Model.CanCreateInternalComment)
            {
                <select class="form-select bug-report-comment-visibility" name="CommentVisibility" aria-label="Comment visibility">
                    <option value="@CommentVisibility.Public">Public</option>
                    <option value="@CommentVisibility.Internal">Internal</option>
                </select>
            }
            else
            {
                <input type="hidden" name="CommentVisibility" value="@CommentVisibility.Public" />
            }

            <button class="btn btn-primary" type="submit">Save</button>
        </div>
    </form>

    <div class="bug-report-activity-scroll">
        @if (!Model.ActivityItems.Any())
        {
            <div class="bug-report-activity-empty">
                No activity yet.
            </div>
        }
        else
        {
            @foreach (var item in Model.ActivityItems)
            {
                <article class="bug-report-activity-item @(item.IsComment ? "bug-report-comment-item" : "bug-report-log-item")">
                    <div class="bug-report-activity-meta">
                        @if (item.IsComment)
                        {
                            <strong>@item.AuthorName</strong>

                            @if (item.CommentVisibility == CommentVisibility.Internal)
                            {
                                <span class="badge bg-warning text-dark">Internal</span>
                            }
                        }
                        else
                        {
                            <span class="bug-report-activity-type">Log</span>
                        }

                        <small class="text-muted ms-auto">
                            @item.CreatedAt.ToDisplayDateTime()
                        </small>
                    </div>

                    <p class="bug-report-comment-text">@item.Message</p>
                </article>
            }
        }
    </div>
</section>

@functions {
    private static string FormatFileSize(long fileSize)
    {
        const long oneKilobyte = 1024;
        const long oneMegabyte = oneKilobyte * 1024;

        if (fileSize >= oneMegabyte)
        {
            return $"{fileSize / (double)oneMegabyte:0.##} MB";
        }

        if (fileSize >= oneKilobyte)
        {
            return $"{fileSize / (double)oneKilobyte:0.##} KB";
        }

        return $"{fileSize} bytes";
    }
}




