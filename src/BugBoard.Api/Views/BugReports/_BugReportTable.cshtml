@model BugReportIndexViewModel

@if (!Model.Reports.Any())
{
    <div class="empty-state">
        <strong>@Localizer["No bug reports found."]</strong>
        <span>@Localizer["Try adjusting your search or filter criteria."]</span>
    </div>
}
else
{
    <div class="bug-report-list">
        @foreach (var item in Model.Reports)
        {
            var detailsUrl = Url.Action("Details", "BugReports", new { id = item.Id });
            var ariaLabel = $"{Localizer["Open bug report"]} {item.Title}";

            <a href="@detailsUrl" class="bug-report-card" aria-label="@ariaLabel">
                <div class="bug-report-card-header">
                    <h2>@item.Title</h2>
                    <p>@item.Description</p>
                </div>

                <div class="bug-report-card-badges">
                    <partial name="_StatusBadge" model="item.Status" />
                    <partial name="_PriorityBadge" model="item.Priority" />
                </div>

                <dl class="bug-report-card-meta">
                    <div>
                        <dt>@Localizer["Assigned To"]</dt>
                        <dd>@(string.IsNullOrWhiteSpace(item.AssignedToUser?.FullName) ? Localizer["Unassigned"] : item.AssignedToUser?.FullName)</dd>
                    </div>

                    <div>
                        <dt>@Localizer["Created"]</dt>
                        <dd>@item.CreateAt.ToDisplayDateTime()</dd>
                    </div>

                    <div>
                        <dt>@Localizer["Updated"]</dt>
                        <dd>@item.UpdatedAt.ToDisplayDateTime()</dd>
                    </div>
                </dl>
            </a>
        }
    </div>

    <div class="bug-report-table-wrapper">
        <table class="table table-hover mb-0 clickable-table">
            <thead>
                <tr>
                    <th>@Localizer["Title"]</th>
                    <th>@Localizer["Description"]</th>
                    <th>@Localizer["Status"]</th>
                    <th>@Localizer["Priority"]</th>
                    <th>@Localizer["Supervisor"]</th>
                    <th>@Localizer["Assigned To"]</th>
                    <th>@Localizer["Created At"]</th>
                    <th>@Localizer["Updated At"]</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model.Reports)
                {
                    var detailsUrl = Url.Action("Details", "BugReports", new { id = item.Id });
                    var ariaLabel = $"{Localizer["Open bug report"]} {item.Title}";

                    <tr>
                        <td>
                            <a href="@detailsUrl" class="table-row-link" aria-label="@ariaLabel">
                                @item.Title
                            </a>
                        </td>

                        <td>
                            <a href="@detailsUrl" class="table-row-link" aria-label="@ariaLabel">
                                @item.Description
                            </a>
                        </td>

                        <td>
                            <a href="@detailsUrl" class="table-row-link" aria-label="@ariaLabel">
                                <partial name="_StatusBadge" model="item.Status" />
                            </a>
                        </td>

                        <td>
                            <a href="@detailsUrl" class="table-row-link" aria-label="@ariaLabel">
                                <partial name="_PriorityBadge" model="item.Priority" />
                            </a>
                        </td>
                        <td>
                            <a href="@detailsUrl" class="table-row-link" aria-label="@ariaLabel">
                                @(string.IsNullOrWhiteSpace(item.Supervisor?.FullName) ? Localizer["Unassigned"] : item.Supervisor?.FullName)
                            </a>
                        </td>

                        <td>
                            <a href="@detailsUrl" class="table-row-link" aria-label="@ariaLabel">
                                @(string.IsNullOrWhiteSpace(item.AssignedToUser?.FullName) ? Localizer["Unassigned"] : item.AssignedToUser?.FullName)
                            </a>
                        </td>

                        <td>
                            <a href="@detailsUrl" class="table-row-link" aria-label="@ariaLabel">
                                @item.CreateAt.ToDisplayDateTime()
                            </a>
                        </td>

                        <td>
                            <a href="@detailsUrl" class="table-row-link" aria-label="@ariaLabel">
                                @item.UpdatedAt.ToDisplayDateTime()
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
