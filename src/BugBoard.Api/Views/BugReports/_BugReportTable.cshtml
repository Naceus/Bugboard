@model BugReportIndexViewModel

<div class="card">
    <table class="table table-hover mb-0 clickable-table">
        <thead>
            <tr>
                <th>Title</th>
                <th>Description</th>
                <th>Status</th>
                <th>Priority</th>
                <th>Assigned To</th>
                <th>Created At</th>
                <th>Updated At</th>
            </tr>
        </thead>

        <tbody>
            @if (Model.Reports.Any())
            {
                @foreach (var item in Model.Reports)
                {
                    var detailsUrl = Url.Action("Details", "BugReports", new { id = item.Id });
                    var ariaLabel = $"Open bug report {item.Title}";
                    <tr>
                        <td>
                            <a href="@detailsUrl"
                                class="table-row-link"
                                aria-label="@ariaLabel">
                                    @item.Title
                            </a>
                        </td>
                        <td>
                            <a href="@detailsUrl"
                            class="table-row-link"
                            aria-label="@ariaLabel">
                                    @item.Description
                            </a>
                        </td>
                        <td>
                            <a href="@detailsUrl" class="table-row-link" aria-label="@ariaLabel">
                                <partial name="_StatusBadge" model="item.Status" />
                            </a>
                        </td>
                        <td>
                            <a href="@detailsUrl" class="table-row-link" aria-label="@ariaLabel">
                                <partial name="_PriorityBadge" model="item.Priority" />
                            </a>
                        </td>
                        <td>
                            <a href="@detailsUrl"
                               class="table-row-link"
                               aria-label="@ariaLabel">
                                    @item.AssignedTo
                            </a>
                        </td>
                        <td>
                            <a href="@detailsUrl"
                               class="table-row-link"
                               aria-label="@ariaLabel">
                                 @item.CreateAt.ToString("dd.MM.yyyy HH:mm")
                            </a>
                        </td>
                        <td>
                            <a href="@detailsUrl"
                               class="table-row-link"
                               aria-label="@ariaLabel">
                                    @(item.UpdatedAt?.ToString("dd.MM.yyyy HH:mm") ?? "-")
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">
                        No bug reports found.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>