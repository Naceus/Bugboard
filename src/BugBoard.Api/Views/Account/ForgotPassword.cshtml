@model ForgotPasswordViewModel

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Forgot Password";
}

@section Styles {
    <link rel="stylesheet" href="~/css/HomeIndex.css" asp-append-version="true" />
}

<div class="login-body">
    <div class="row g-0 min-vh-100 w-100 m-0">
        <section class="col-12 d-flex align-items-center justify-content-center bg-white p-4 p-lg-5">
            <div class="login-inner w-100">
                <div class="login-logo mx-auto mb-4">
                    BB
                </div>

                <h1 class="text-center fw-bold mb-2">
                    Forgot your password?
                </h1>

                <p class="text-center text-muted mb-4">
                    Enter your email address to start the password reset process.
                </p>

                <form asp-controller="Account" asp-action="ForgotPassword" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-4">
                        <label asp-for="EmailAddress" class="form-label fw-semibold"></label>

                        <input asp-for="EmailAddress"
                               class="form-control form-control-lg"
                               placeholder="name@example.com"
                               autocomplete="email" />

                        <span asp-validation-for="EmailAddress" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 login-button">
                        Continue
                    </button>

                    <p class="text-center mt-3 mb-0">
                        Remember your password?
                        <a asp-controller="Home"
                           asp-action="Index"
                           class="fw-semibold text-decoration-none">
                            Back to sign in
                        </a>
                    </p>
                </form>
            </div>
        </section>
    </div>
</div>