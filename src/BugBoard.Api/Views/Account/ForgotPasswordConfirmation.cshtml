
@{
    ViewData["Title"] = "Forgot Password Confirmation";
    Layout = "_AuthLayout";
}
@section Styles{
    <link rel="stylesheet" href="~/css/HomeIndex.css" asp-append-version="true"/>
}

<div class="login-body">
    <div class="row g-0 min-vh-100 w-100 m-0">
        <section class="col-12 d-flex align-items-center justify-content-center bg-white p-4 p-lg-5">
            <div class="login-inner text-center w-100">
                <div class="login-logo mx-auto mb-4">
                    BB
                </div>
                <h1 class="fw-bold mb-2">
                    Check your Email
                </h1>
                <p class="text-muted mb-4">
                    If an account exists for this email address, a password reset link has been created.
                </p>
                <p class="text-muted mb-4">
                    For security reasons, reset links expire after a short time.
                </p>
                @if (TempData["ResetPasswordLink"] is string resetLink)
                {
                    <div class="alert alert-warning text-start mb-4">
                        <strong>Development only</strong>
                        <p class="mb-2">Email sending is not configured yet. Use this reset link for testing:</p>
                        <a href="@resetLink" class="alert-link text-break">@resetLink</a>
                    </div>

                }
                <a asp-controller="Home"
                    asp-action="Index"
                    class="btn btn-primary btn-lg w-100 login-button">
                    Back to sign in
                </a>
            </div>
        </section>
    </div>
</div>