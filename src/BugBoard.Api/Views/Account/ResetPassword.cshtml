@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
    Layout = "_AuthLayout";
}
@section Styles{
    <link rel="stylesheet" href="~/css/HomeIndex.css" asp-append-version="true"/>
}


<div class="login-body">
    <div class="row g-0 min-vh-100 w-100 m-0">
        <section class="col-12 d-flex align-items-center justify-content-center bg-white p-4 p-lg-5">
            <div class="login-inner text-center w-100">
                <div class="login-logo mx-auto mb-4">
                    BB
                </div>
                <h1 class="fw-bold mb-2">
                    Reset your password
                </h1>
                <p class="text-muted mb-4">
                    Choose a new password for your BugBoard account.
                </p>
                <form asp-controller="Account" asp-action="ResetPassword" method="post">
                    @Html.AntiForgeryToken()
                    <input asp-for="EmailAddress" type="hidden" />
                    <input asp-for="Token" type="hidden" />

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-4">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password"
                        class="form-control"
                        placeholder="password"
                        autocomplete="new-password"/>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label fw-bold"></label>
                        <input asp-for="ConfirmPassword"
                            class="form-control"
                            placeholder="Confirm password"
                            autocomplete="new-password"/>
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>
                    <div class="d-flex gap-2">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-dark">
                            Back to Login
                        </a>
                    <button type="submit" class="btn btn-success">
                        Confirm
                    </button>
                    </div>
                </form>
            </div>
        </section>
    </div>
</div>