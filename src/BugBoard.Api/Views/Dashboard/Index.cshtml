@using BugBoard.Api.ViewModels.Dashboard
@model DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/dashboard.css" asp-append-version="true" />
}

<div class="dashboard-page">
    <section class="dashboard-metrics" aria-label="Dashboard metrics">
        @foreach (var metric in Model.Metrics)
        {
            @if (metric.FilterUrl != null)
            {
                <a href="@metric.FilterUrl" style="text-decoration:none" class="dashboard-metric-card dashboard-metric-card--@metric.Variant">
                    @await Html.PartialAsync("_DashboardMetricCard", metric)
                </a>
                
            }
            else
            {
                <article class="dashboard-metric-card dashboard-metric-card--@metric.Variant">
                    @await Html.PartialAsync("_DashboardMetricCard", metric)
                </article>
            }
        }
    </section>

    <section class="dashboard-grid">
        <article class="dashboard-card">
            <div class="dashboard-card-header">
                <div>
                    <h2>@Localizer["Recent Reports"]</h2>
                    <p>@Localizer["Your latest bug reports and updates."]</p>
                </div>

                <a asp-controller="BugReports"
                   asp-action="Index"
                   class="dashboard-card-link">
                    @Localizer["View all"]
                </a>
            </div>

            @if (!Model.RecentReports.Any())
            {
                <div class="dashboard-empty-state">
                    <strong>@Localizer["No reports yet."]</strong>
                    <span>@Localizer["Create your first bug report to start tracking issues."]</span>
                </div>
            }
            else
            {
                <div class="dashboard-report-list">
                    @foreach (var report in Model.RecentReports)
                    {
                        <a asp-controller="BugReports"
                           asp-action="Details"
                           asp-route-id="@report.Id"
                           class="dashboard-report-item">

                            <div class="dashboard-report-main">
                                <h3>@report.Title</h3>

                                <div class="dashboard-report-badges">
                                    <span class="dashboard-badge">
                                        @Localizer[report.Status]
                                    </span>

                                    <span class="dashboard-badge dashboard-badge--priority">
                                        @Localizer[report.Priority]
                                    </span>
                                </div>
                            </div>

                            <div class="dashboard-report-meta">
                                @Localizer["Last activity:"] @report.LastActivityAt.ToDisplayDateTime()
                            </div>
                        </a>
                    }
                </div>
            }
        </article>

        <aside class="dashboard-card dashboard-actions-card">
            <div class="dashboard-card-header">
                <div>
                    <h2>@Localizer["Quick Actions"]</h2>
                    <p>@Localizer["Common actions for your workflow."]</p>
                </div>
            </div>

            <div class="dashboard-actions">
                <a asp-controller="BugReports"
                   asp-action="Create"
                   class="btn btn-primary btn-lg w-100">
                    @Localizer["Create Report"]
                </a>

                <a asp-controller="BugReports"
                   asp-action="Index"
                   class="btn btn-outline-secondary btn-lg w-100">
                    @Localizer["View My Reports"]
                </a>
            </div>
        </aside>
    </section>
</div>
