@model AdminUserIndexViewModel

@if (!Model.Users.Any())
{
    <div class="alert alert-info">
        @Localizer["No users found."]
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <h2 class="h5 mb-0">@Localizer["Users"]</h2>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 clickable-table">
                <thead class="table-light">
                    <tr>
                        <th scope="col">@Localizer["Full Name"]</th>
                        <th scope="col">@Localizer["Email Address"]</th>
                        <th scope="col">@Localizer["Role"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Users)
                    {
                        var editUrl = Url.Action("EditUser", "Admin", new { id = user.Id });
                        var displayName = string.IsNullOrWhiteSpace(user.FullName)
                            ? user.Email
                            : user.FullName;
                        var ariaLabel = $"{Localizer["Edit user"]} {displayName}";
                        var roleText = string.IsNullOrWhiteSpace(user.Roles)
                            ? Localizer["Unassigned"]
                            : string.Join(", ", user.Roles.Split(", ").Select(r => Localizer[r].Value));
                        <tr>
                            <td>
                                <a href="@editUrl"
                                   class="table-row-link fw-bold"
                                   aria-label="@ariaLabel">
                                    @displayName
                                </a>
                            </td>

                            <td>
                                <a href="@editUrl"
                                   class="table-row-link"
                                   aria-label="@ariaLabel">
                                    @user.Email
                                </a>
                            </td>

                            <td>
                                <a href="@editUrl"
                                   class="table-row-link"
                                   aria-label="@ariaLabel">
                                    <span class="badge bg-secondary">@roleText</span>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
