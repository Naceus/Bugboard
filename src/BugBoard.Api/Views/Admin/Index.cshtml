@model List<AdminUserListItemViewModel>

@{
    ViewData["Title"] = "Admin Area";
}


<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Admin Area</h1>
        <p class="text-muted mb-0">Manage users and their roles.</p>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No users found.
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <h2 class="h5 mb-0">Users</h2>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 clickable-table">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Full Name</th>
                        <th scope="col">Email Address</th>
                        <th scope="col">Role</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>
                                <a asp-controller="Admin"
                                   asp-action="EditUser"
                                   asp-route-id="@user.Id"
                                   class="table-row-link"
                                   aria-label="Edit user @user.FullName @user.Email">
                                    @user.FullName
                                </a>
                            </td>

                            <td>
                                <a asp-controller="Admin"
                                   asp-action="EditUser"
                                   asp-route-id="@user.Id"
                                   class="table-row-link"
                                   aria-label="Edit user @user.FullName @user.Email">
                                    @user.Email
                                </a>
                            </td>

                            <td>
                                <a asp-controller="Admin"
                                   asp-action="EditUser"
                                   asp-route-id="@user.Id"
                                   class="table-row-link"
                                   aria-label="Edit user @user.FullName @user.Email">
                                    <span class="badge bg-secondary">
                                        @user.Roles
                                    </span>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}