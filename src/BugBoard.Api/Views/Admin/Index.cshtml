@model List<AdminUserListItemViewModel>
@{
    ViewData["Title"] = "Admin Area";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Admin Area</h1>
        <p class="text-muted mb-0">Manage users and their roles.</p>
    </div>
</div>
@if (!Model.Any())
{
    <div class="alert alert-info">
        No users found.
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <h2 class="h5 mn-0">Users</h2>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Full Name</th>
                        <th>Email Address</th>
                        <th>Role</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach(var user in Model)
                    {
                        <tr>
                            <td>@user.FullName</td>
                            <td>@user.Email</td>
                            <td>
                                <span class="badge bg-secondary">
                                    @user.Roles
                                </span>
                            </td>
                            <td class="text-end">
                                <a asp-controller="Admin" asp-action="EditRoles" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary">
                                    Edit roles
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
