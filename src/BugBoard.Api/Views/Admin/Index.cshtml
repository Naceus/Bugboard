@model AdminUserIndexViewModel

@{
    ViewData["Title"] = "Admin Area";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>@Localizer["Admin Area"]</h1>
        <p class="text-muted mb-0">@Localizer["Manage users and their roles."]</p>
    </div>
</div>

<form id="adminUserFilterForm" asp-action="Index" method="get" class="mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-6">
            <label for="adminUserSearch" class="form-label">@Localizer["Search"]</label>
            <input name="search"
                   id="adminUserSearch"
                   class="form-control"
                   placeholder="@Localizer["Search name or email"]"
                   value="@Model.Search" />
        </div>

        <div class="col-md-4">
            <label for="adminRoleFilter" class="form-label">@Localizer["Role"]</label>
            <select name="role"
                    id="adminRoleFilter"
                    class="form-select">
                <option value="">@Localizer["All roles"]</option>

                @foreach (var role in Model.AvailableRoles)
                {
                    <option value="@role" selected="@(Model.SelectedRole == role)">
                        @Localizer[role]
                    </option>
                }
            </select>
        </div>

        <div class="col-md-2 d-flex gap-2">
            <a asp-action="Index" class="btn btn-secondary w-100">
                @Localizer["Reset"]
            </a>
        </div>
    </div>
</form>

<div id="adminUserTableContainer">
    <partial name="_AdminUserTable" model="Model" />
</div>

@section Scripts {
    <script src="~/js/admin-user-search.js" asp-append-version="true"></script>
}
