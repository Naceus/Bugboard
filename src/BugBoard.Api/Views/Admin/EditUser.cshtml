@model EditUserViewModel

@{
    ViewData["Title"] = "Edit User";
    ViewData["Subtitle"] = "Update user information and role assignment.";
}

<div class="card shadow-sm">
    <div class="card-header bg-white">
        <h2 class="h5 mb-0">@Model.FullName</h2>
    </div>

    <div class="card-body">
        <form asp-action="EditUser" asp-route-id="@Model.UserId" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="UserId" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="FirstName" class="form-label fw-semibold"></label>
                    <input asp-for="FirstName" class="form-control" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="LastName" class="form-label fw-semibold"></label>
                    <input asp-for="LastName" class="form-control" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label fw-semibold"></label>
                <input asp-for="Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="SelectedRole" class="form-label fw-semibold">
                    @Localizer["Role"]
                </label>

                <select asp-for="SelectedRole" class="form-select">
                    @foreach (var role in Model.AvailableRoles)
                    {
                        <option value="@role">@Localizer[role]</option>
                    }
                </select>

                <span asp-validation-for="SelectedRole" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <a asp-action="Index" class="btn btn-dark">@Localizer["Back"]</a>

                <button type="submit" class="btn btn-success">
                    @Localizer["Save"]
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
