@model LoginViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Login";
}
@section Styles{
    <link rel="stylesheet" href="~/css/HomeIndex.css" asp-append-version="true" />
}

<div class="login-body ">
    <div class="row g-0 min-vh-100 w-100 m-0">

        <section class="col-12 col-lg-5 d-flex align-items-center justify-content-center bg-white p-4 p-lg-5">
            <div class="login-inner w-100">

                <div class="login-logo mx-auto  mb-4">
                    BB
                </div>

                <h1 class="text-center fw-bold mb-2">
                    Welcome back
                </h1>

                <p class="text-center text-muted mb-4">
                    Sign in to access your BugBoard workspace.
                </p>

                <form asp-controller="Account" asp-action="Login" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label for="email" class="form-label fw-semibold">
                            Email Address
                        </label>

                        <div class="input-group input-group-lg">
                            <span class="input-group-text">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="13" viewBox="0 0 14 11" fill="none">
                                    <path fill="#B8BCC6" d="M12.25.5H1.75C1.06.5.5 1.06.5 1.75v7.5c0 .69.56 1.25 1.25 1.25h10.5c.69 0 1.25-.56 1.25-1.25v-7.5C13.5 1.06 12.94.5 12.25.5Zm0 1.25v.18L7 5.21 1.75 1.93v-.18h10.5ZM1.75 9.25V3.38l4.92 3.07c.2.13.46.13.66 0l4.92-3.07v5.87H1.75Z" />
                                </svg>
                            </span>

                            <input asp-for="EmailAddress"
                                   class="form-control"
                                   placeholder="name@example.com"
                                   autocomplete="email"
                                   required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="password" class="form-label fw-semibold">
                            Password
                        </label>

                        <div class="input-group input-group-lg">
                            <span class="input-group-text">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="15" viewBox="0 0 13 12" fill="none">
                                    <path fill="#B8BCC6" d="M8.25 1.125A3.391 3.391 0 0 1 11.625 4.5 3.376 3.376 0 0 1 8.25 7.875c-.445 0-.89-.07-1.266-.234L6 8.625h-.75V9.75H4.125v1.125h-2.25v-2.25l3.14-3.14a3.288 3.288 0 0 1-.14-.962V4.5c0-1.852 1.5-3.375 3.375-3.375ZM8.25 0a4.486 4.486 0 0 0-4.5 4.5c0 .21 0 .422.023.633L.914 8.016c-.117.093-.164.234-.164.398v3.024c0 .328.234.562.563.562h3.375a.555.555 0 0 0 .562-.563v-.562h.563a.555.555 0 0 0 .562-.563v-.468l.938-.938c.304.07.609.094.937.094 2.484 0 4.5-1.992 4.5-4.5 0-2.484-2.016-4.5-4.5-4.5Zm0 3.375A1.11 1.11 0 0 0 9.375 4.5c.61 0 1.125-.492 1.125-1.125A1.14 1.14 0 0 0 9.375 2.25c-.633 0-1.125.516-1.125 1.125Z" />
                                </svg>
                            </span>

                            <input asp-for="Password"
                                   class="form-control"
                                   placeholder="Your password"
                                   autocomplete="current-password"
                                   required />
                        </div>
                    </div>

                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 mb-4">
                        <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input"/>

                            <label asp-for="RememberMe" class="form-check-label" >
                                Remember me
                            </label>
                        </div>

                        <a asp-controller="Account" asp-action="ForgotPassword" class="text-decoration-none fw-semibold">
                            Forgot your password?
                        </a>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 login-button">
                        Sign In
                    </button>
                    <p class="text-center">Don´t have an account yet?
                        <a asp-controller="Account" asp-action="Register" class="text-decoration-none">
                            Create an account
                        </a>
                    </p>
                </form>
            </div>
        </section>

        <section class=" col-12 col-lg-7 d-none d-lg-flex align-items-center justify-content-center login-hero-section p-5">
            <div class="login-hero w-100">
                <h2 class="display-5 fw-bold mb-4">
                    Manage bugs with a clear and structured workflow.
                </h2>

                <p class="lead mb-5">
                    BugBoard helps teams create, track and prioritize bug reports while keeping
                    status changes and responsibilities transparent.
                </p>

                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="login-feature-card h-100">
                            <h3>Bug Tracking</h3>
                            <p>Create and manage bug reports in one structured overview.</p>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="login-feature-card h-100">
                            <h3>Status Workflow</h3>
                            <p>Follow each report from open to resolved with clear stauts updates.</p>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="login-feature-card h-100">
                            <h3>Priority Management</h3>
                            <p>Keep critical issues visible and focus on what matters first.</p>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="login-feature-card h-100">
                            <h3>Fast Filtering</h3>
                            <p>Find relevant reports quickly with search, status and priority filteres.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

    </div>
</div>