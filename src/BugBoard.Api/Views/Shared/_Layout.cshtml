@{
    string? currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    string pageTitle = ViewData["Title"]?.ToString() ?? "Dashboard";
    string currentCulture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    string pageSubtitle = ViewData["Subtitle"]?.ToString() ?? "Track, prioritize and manage software issues efficiently.";
}

<!DOCTYPE html>
<html lang="@currentCulture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@Localizer[pageTitle] - BugBoard</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BugBoard.Api.styles.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="app-shell">
        <aside class="app-sidebar">
            <div class="sidebar-brand">
                <a asp-controller="Dashboard" asp-action="Index" class="brand-link">
                    <div class="brand-icon">BB</div>

                    <div class="brand-text">
                        <strong>BugBoard</strong>
                        <span>@Localizer["Issue Management"]</span>
                    </div>
                </a>
            </div>

            <nav class="sidebar-nav" aria-label="Main navigation">
                <div class="sidebar-section-title">@Localizer["Navigation"]</div>

                <a asp-controller="Dashboard"
                   asp-action="Index"
                   class="sidebar-link @(currentController == "Dashboard" ? "active" : "")">
                    <span class="sidebar-link-icon">⌂</span>
                    <span class="sidebar-link-text">@Localizer["Dashboard"]</span>
                </a>

                <a asp-controller="BugReports"
                   asp-action="Index"
                   class="sidebar-link @(currentController == "BugReports" ? "active" : "")">
                    <span class="sidebar-link-icon">!</span>
                    <span class="sidebar-link-text">@Localizer["Bug Reports"]</span>
                </a>

                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Admin"
                       asp-action="Index"
                       class="sidebar-link @(currentController == "Admin" ? "active" : "")">
                        <span class="sidebar-link-icon">⚙</span>
                        <span class="sidebar-link-text">@Localizer["Administration"]</span>
                    </a>
                }
            </nav>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="sidebar-footer">
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()

                        <button type="submit" class="sidebar-logout-button">
                            <span class="sidebar-link-icon">↪</span>
                            <span class="sidebar-link-text">@Localizer["Logout"]</span>
                        </button>
                    </form>
                </div>
            }
        </aside>

        <main class="app-main">
            <header class="app-header">
                <div>
                    <h1>@Localizer[pageTitle]</h1>
                    <p>@Localizer[pageSubtitle]</p>
                </div>
                <form class="language-switcher" asp-controller="Localization" asp-action="SetLanguage" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                    <label class="visually-hidden" for="culture">@Localizer["Language"]</label>
                    <select id="culture" name="culture" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="en" selected="@(currentCulture == "en")">@Localizer["English"]</option>
                        <option value="de" selected="@(currentCulture == "de")">@Localizer["German"]</option>
                    </select>
                </form>
            </header>

            <section class="app-content">
                @RenderBody()
            </section>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
