@{
    string? currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    string pageTitle = ViewData["Title"]?.ToString() ?? "Dashboard";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@pageTitle - BugBoard</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BugBoard.Api.styles.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="app-shell">
        <aside class="app-sidebar">
            <div class="sidebar-brand">
                <a asp-controller="Home" asp-action="Index" class="brand-link">
                    <div class="brand-icon">BB</div>

                    <div class="brand-text">
                        <strong>BugBoard</strong>
                        <span>Issue Management</span>
                    </div>
                </a>
            </div>

            <nav class="sidebar-nav" aria-label="Main navigation">
                <div class="sidebar-section-title">Navigation</div>

                <a asp-controller="Home"
                   asp-action="Index"
                   class="sidebar-link @(currentController == "Home" ? "active" : "")">
                    <span class="sidebar-link-icon">⌂</span>
                    <span class="sidebar-link-text">Dashboard</span>
                </a>

                <a asp-controller="BugReports"
                   asp-action="Index"
                   class="sidebar-link @(currentController == "BugReports" ? "active" : "")">
                    <span class="sidebar-link-icon">!</span>
                    <span class="sidebar-link-text">Bug Reports</span>
                </a>

                <a asp-controller="Admin"
                   asp-action="Index"
                   class="sidebar-link @(currentController == "Admin" ? "active" : "")">
                    <span class="sidebar-link-icon">⚙</span>
                    <span class="sidebar-link-text">Administration</span>
                </a>
            </nav>
        </aside>

        <main class="app-main">
            <header class="app-header">
                <div>
                    <h1>@pageTitle</h1>
                    <p>Track, prioritize and manage software issues efficiently.</p>
                </div>
            </header>

            <section class="app-content">
                @RenderBody()
            </section>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>