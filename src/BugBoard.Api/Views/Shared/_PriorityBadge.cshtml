@model BugPriority
@switch (Model)
{
    case BugPriority.Critical:
        <span class="badge bg-danger">Critical</span>
        break;
    case BugPriority.Medium:
        <span class="badge bg-warning">Medium</span>
        break;
    case BugPriority.Low:
        <span class="badge bg-success">Low</span>
        break;
         
}