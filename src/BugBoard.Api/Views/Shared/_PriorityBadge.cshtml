@model BugPriority
@switch (Model)
{
    case BugPriority.Critical:
        <span class="badge bg-danger">@Localizer["Critical"]</span>
        break;
    case BugPriority.Medium:
        <span class="badge bg-warning">@Localizer["Medium"]</span>
        break;
    case BugPriority.Low:
        <span class="badge bg-success">@Localizer["Low"]</span>
        break;
         
}
